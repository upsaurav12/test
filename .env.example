# Copy this file to .env and fill in the values.
# Never commit .env – it is listed in .gitignore.

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=local            # local | development | production

# ── Database ───────────────────────────────────────────────────────────────────
GONE_DB_HOST=localhost
GONE_DB_PORT=5431        # host-side port; the container listens on 5432 internally
GONE_DB_DATABASE=myapp
GONE_DB_USERNAME=myapp_user
GONE_DB_PASSWORD=change_me
GONE_DB_SCHEMA=public
# Use "disable" only for local dev; set "require" (or "verify-full") in production.
GONE_DB_SSLMODE=disable
# Connection pool tuning.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECS=300
# Set true only in local/dev if you intentionally want GORM AutoMigrate at startup.
DB_AUTO_MIGRATE=false

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRY_HOURS=24

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.  Use "*" only in local dev.
CORS_ALLOWED_ORIGINS=*
